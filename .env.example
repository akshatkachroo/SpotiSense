# API configuration
PORT=8080
APP_ENV=development
DATABASE_URL=postgres://spotisense:spotisense@localhost:5432/spotisense?sslmode=disable
REDIS_URL=redis://localhost:6379/0
TRACKS_PATH=data/tracks.csv
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional Spotify metadata enrichment. Recommendations work without these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Vite embeds these values when the frontend is built.
VITE_API_URL=http://localhost:8080
VITE_EMOTION_MODEL=/models/spotisense-emotion
